{
  "info": {
    "name": "WebBazar API",
    "_postman_id": "webbazar-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "orderItemId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth / Login (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@webbazar.com\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "  pm.environment.set('jwt', json.token);",
              "}",
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth / Login (User)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@webbazar.com\",\n  \"password\": \"User123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "  pm.environment.set('jwt', json.token);",
              "}",
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth / Register (Public)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nieuweuser@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"Nieuwe Gebruiker\",\n  \"address\": \"Testlaan 10\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Auth / Me (Get Profile, JWT required)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Auth / Me (Update Profile + Password, JWT required)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nieuwe Naam\",\n  \"address\": \"Nieuwe Straat 123\",\n  \"newPassword\": \"NieuwWachtwoord123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Products / Get All (Public)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Products / Add (Admin, multipart)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "product",
              "type": "text",
              "contentType": "application/json",
              "value": "{\"title\":\"Nieuw Boek\",\"author\":\"Auteur Naam\",\"description\":\"Beschrijving...\",\"price\":29.99,\"rentalPrice\":2.99}"
            },
            {
              "key": "file",
              "type": "file",
              "src": [
                "uploads/test/Gedicht.pdf"
              ]
            }
          ]
        },
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json;",
              "try {",
              "  json = pm.response.json();",
              "} catch (e) {",
              "  json = null;",
              "}",
              "if (json && json.id) {",
              "  pm.environment.set('productId', json.id);",
              "}",
              "pm.test('Status 201 or 200', function () {",
              "  pm.expect(pm.response.code === 201 || pm.response.code === 200).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders / Get My Orders (JWT required)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Orders / Checkout (JWT required)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"BUY\",\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 1 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/orders/checkout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json;",
              "try {",
              "  json = pm.response.json();",
              "} catch (e) {",
              "  json = null;",
              "}",
              "// orderId opslaan voor factuur-download",
              "if (json && json.id) {",
              "  pm.environment.set('orderId', json.id);",
              "}",
              "// eerste orderItemId opslaan voor ebook-download",
              "if (json && json.items && json.items.length) {",
              "  pm.environment.set('orderItemId', json.items[0].id);",
              "}",
              "pm.test('Status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders / Checkout Rent (JWT required)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"RENT\",\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 1 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/orders/checkout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json;",
              "try {",
              "  json = pm.response.json();",
              "} catch (e) {",
              "  json = null;",
              "}",
              "// orderId opslaan voor factuur-download (huur)",
              "if (json && json.id) {",
              "  pm.environment.set('orderId', json.id);",
              "}",
              "// eerste orderItemId opslaan voor ebook-download (huur)",
              "if (json && json.items && json.items.length) {",
              "  pm.environment.set('orderItemId', json.items[0].id);",
              "}",
              "pm.test('Status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Downloads / By OrderItemId (JWT required)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/downloads/{{orderItemId}}"
      }
    },
    {
      "name": "Orders / Invoice (JWT required)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/orders/{{orderId}}/invoice"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type is PDF', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
              "});"
            ]
          }
        }
      ]
    },

    {
      "name": "Products / Delete (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },

    {
      "name": "Admin / Users",
      "item": [
        {
          "name": "Admin Users / Get All",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users"
          }
        },
        {
          "name": "Admin Users / Get By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin Users / Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@webbazar.com\",\n  \"password\": \"NewUser123!\",\n  \"name\": \"New User\",\n  \"address\": \"Some Street 1\",\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json;",
                  "try {",
                  "  json = pm.response.json();",
                  "} catch (e) {",
                  "  json = null;",
                  "}",
                  "if (json && json.id) {",
                  "  pm.environment.set('userId', json.id);",
                  "}",
                  "pm.test('Status 201 or 200', function () {",
                  "  pm.expect(pm.response.code === 201 || pm.response.code === 200).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Users / Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated User Name\",\n  \"address\": \"Updated Street 2\",\n  \"enabled\": false,\n  \"password\": \"NewPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin Users / Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}"
          }
        },
        {
          "name": "Admin Users / Block (enabled: false)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}"
            },
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/enabled"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json;",
                  "try {",
                  "  json = pm.response.json();",
                  "} catch (e) {",
                  "  json = null;",
                  "}",
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (json && Object.prototype.hasOwnProperty.call(json, 'enabled')) {",
                  "  pm.test('Enabled is false na blokkeren', function () {",
                  "    pm.expect(json.enabled).to.eql(false);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Users / Unblock (enabled: true)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/enabled"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json;",
                  "try {",
                  "  json = pm.response.json();",
                  "} catch (e) {",
                  "  json = null;",
                  "}",
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (json && Object.prototype.hasOwnProperty.call(json, 'enabled')) {",
                  "  pm.test('Enabled is true na deblokkeren', function () {",
                  "    pm.expect(json.enabled).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
